{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "src/**/*",
    "main.ts",
    "preload.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-main",
    "dist-preload",
    "tests/e2e/**",
    "tests/**/*.js"
  ]
}
